# ============================================================
# CONFIGURACIÓN BÁSICA Y EJECUCIÓN PHP
# ============================================================
# PRIMERO: Configurar ejecución de PHP (esto debe ir antes de cualquier RewriteRule)
<IfModule mod_php.c>
    # Habilitar PHP
    php_flag engine on
</IfModule>

# Configuración específica para Hostinger
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>

<IfModule mod_mime.c>
    AddHandler application/x-httpd-php .php
    AddType application/x-httpd-php .php
</IfModule>

# Solo establecer Content-Type para archivos HTML/PHP
<IfModule mod_headers.c>
    <FilesMatch "\.(php|html?)$">
        Header set Content-Type "text/html; charset=UTF-8"
    </FilesMatch>
</IfModule>

# Ahora las reglas de reescritura
RewriteEngine On
RewriteBase /

# No redirigir carpetas del sistema
RewriteRule ^(api|admin_tablas|dashboard|de|en|fr|zh)/ - [L]

# Excepciones: Archivos PHP directamente accesibles
RewriteRule ^.*\.php$ - [L]

# URLs amigables básicas
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^alojamiento/([^/]+)/?$ redirect_manager.php?type=alojamiento&slug=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^lugar/([^/]+)/?$ redirect_manager.php?type=lugar&slug=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^actividad/([^/]+)/?$ redirect_manager.php?type=actividad&slug=$1 [L,QSA]

# Eventos
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^evento/([^/]+)/?$ evento-detalle.php?slug=$1 [L,QSA]

# Excluir archivos estáticos de reglas catch-all
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|php|html)$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/?$ /lugar/$1 [R=301,L]