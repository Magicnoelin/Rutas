a antes. Reserva tu vuelo en globo con nosotros y disfruta de una experiencia que recordarás para siempre!","images":[{"imageSource":"SUPPLIER_PROVIDED","caption":"","isCover":true,"variants":[{"height":100,"width":100,"url":"https://media-cdn.tripadvisor.com/media/attractions-splice-spp-100x100/12/d7/25/15.jpg"},{"height":200,"width":200,"url":"https://media-cdn.tripadvisor.com/media/attractions-splice-spp-200x200/12/d7/25/15.jpg"},{"height":400,"width":400,"url":"https://media-cdn.tripadvisor.com/media/attractions-splice-spp-400x400/12/d7/25/15.jpg"},{"height":240,"width":360,"url":"https://media-cdn.tripadvisor.com/media/attractions-splice-spp-360x240/12/d7/25/15.jpg"},{"height":320,"width":480,"url":"https://media-cdn.tripadvisor.com/media/attractions-splice-spp-480x320/12/d7/25/15.jpg"},{"height":360,"width":540,"url":"https://media-cdn.tripadvisor.com/media/attractions-splice-spp-540x360/12/d7/25/15.jpg"},{"height":446,"width":674,"url":"https://media-cdn.tripadvisor.com/media/attractions-splice-spp-674x446/12/d7/25/15.jpg"},{"height":480,"width":720,"url":"https://media-cdn.tripadvisor.com/media/attractions-splice-spp-720x480/12/d7/25/15.jpg"},{"height":118,"width":210,"url":"https://media-cdn.tripadvisor.com/media/attractions-splice-spp-210x118/12/d7/25/15.jpg"},{"height":75,"width":75,"url":"https://media-cdn.tripadvisor.com/media/attractions-splice-spp-75x75/12/d7/25/15.jpg"}]}],"reviews":{"sources":[{"provider":"VIATOR","totalCount":53,"averageRating":4.5},{"provider":"TRIPADVISOR","totalCount":33,"averageRating":4.8}],"totalReviews":86,"combinedAverageRating":4.604651},"duration":{"fixedDurationInMinutes":180},"confirmationType":"INSTANT_THEN_MANUAL","itineraryType":"ACTIVITY","pricing":{"summary":{"fromPrice":130.00},"currency":"EUR"},"productUrl":"https://www.viator.com/es-ES/tours/Segovia/Balloon-flight-at-sunrise-in-Segovia/d26564-437673P1?mcid=42383&pid=P00316112&medium=api&api_version=2.0","destinations":[{"ref":"26564","primary":true}],"tags":[119